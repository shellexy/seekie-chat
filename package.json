{
  "name": "seekie-chat",
  "version": "0.2.0",
  "private": true,
  "productName": "seekie-chat",
  "description": "Linux desktop LLM chat with conversation branches",
  "author": "Shellexy <299902+shellexy@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/shellexy/seekie-chat",
  "desktopName": "com.github.shellexy.seekie-chat",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/smoke.mjs",
    "test:dev": "node scripts/check-dev.mjs",
    "check": "npm run typecheck && npm test",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@aurouscia/image-compress": "^0.2.0",
    "@firecrawl/anydoc": "^0.2.4",
    "defuddle": "^0.19.5",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.github.shellexy.seekie-chat",
    "productName": "seekie-chat",
    "executableName": "seekie-chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "dist-electron/icon.png"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network;Chat;Development;",
      "executableName": "seekie-chat",
      "desktop": {
        "entry": {
          "Name": "Seekie Chat",
          "StartupWMClass": "com.github.shellexy.seekie-chat",
          "Keywords": "chat;llm;deepseek;ai;",
          "StartupNotify": "true"
        }
      },
      "description": "Seekie Chat with DeepSeek LLM"
    },
    "appImage": {
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${name}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
